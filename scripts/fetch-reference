#!/usr/bin/env python3
"""Fetch the pinned, hash-checked C sources used by the regression tests."""
import argparse
import hashlib
import json
from pathlib import Path
import urllib.request

ROOT = Path(__file__).resolve().parents[1]
CACHE = ROOT / 'artifacts/reference/chocolate-doom-3.1.1'


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--offline', action='store_true', help='verify cached files without networking')
    args = parser.parse_args()
    files = {}
    for name in ('manifest.json', 'audio.json'):
        spec = json.loads((ROOT/'tests/reference'/name).read_text())
        for path, digest in spec['files'].items():
            entry = (spec['commit'], digest)
            if path in files and files[path] != entry:
                raise ValueError(f'inconsistent pinned source: {path}')
            files[path] = entry
    for name, (commit, expected) in sorted(files.items()):
        path = CACHE/name
        if path.exists():
            data = path.read_bytes()
        elif args.offline:
            raise FileNotFoundError(f'missing {path}; run ./scripts/fetch-reference')
        else:
            url = f'https://raw.githubusercontent.com/chocolate-doom/chocolate-doom/{commit}/{name}'
            with urllib.request.urlopen(url, timeout=30) as response:
                data = response.read()
        if hashlib.sha256(data).hexdigest() != expected:
            raise ValueError(f'pinned source hash mismatch: {name}')
        if not path.exists():
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_bytes(data)
    print(f'Verified {len(files)} pinned C reference files in {CACHE.relative_to(ROOT)}')


if __name__ == '__main__':
    main()
