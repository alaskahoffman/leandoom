import Doom.Proofs.E1M1ScanGeometry
set_option backward.isDefEq.respectTransparency false
set_option maxRecDepth 32768
set_option maxHeartbeats 1800000
namespace Doom.Proofs.E1M1ScanContracts
open Verification X86 X86Memory X86Control BlockSummary
open E1M1ScanMemory (firstScan)
open E1M1ScanGeometry (linePointer SideSafe ScratchSafe Geometry)
open OriginalLineMixedInvariant (atIndex Candidate ArraySafe)

/-- Autoaim requests lines and things (3), without the early-out bit (4).
The zero below is generated by initialization, not assumed at scan entry. -/
theorem firing_active (gun : Fire.Gun) (s : X86Memory.State) (actor : Word)
    (thing : Collision.SolidThing) (angle : Angle) (ox oy : Fixed)
    (geometry : E1M1FiringGeometry.Inputs gun s actor thing angle ox oy)
    (safe : E1M1PathMapSetup.StackSafe (s.regs 4-(112#32)) (0x2c024#32)) :
    load32 (firstScan gun s).core.memory 0x2c024=0 := by
  change load32 (firstScan gun s).core.memory (0x2c024#32)=(0#32)
  rw [E1M1ScanMemory.firing_initialized_frame gun s actor thing angle ox oy geometry _ safe]
  have q := E1M1FiringGeometry.query_geometry gun s actor thing angle ox oy geometry
  have ready := OriginalPathInit.ready _ ox oy _ _ _ _ (E1M1AimGeometry.path_inputs _ thing angle _ ox oy q)
  have flags := congrArg (fun t => t.2.1) (OriginalAimSetup.call_frame _ (E1M1AimGeometry.setup_inputs _ thing angle _ ox oy q).separated)
  have active := congrArg (fun t => t.2.1) ready.globals
  exact active.trans ((congrArg (fun v : Word => v &&& 4) flags).trans (by decide))

/-- The back-sector null test is transported from the initial line encoding. -/
theorem firing_back (gun : Fire.Gun) (s : X86Memory.State) (actor : Word)
    (thing : Collision.SolidThing) (angle : Angle) (ox oy : Fixed)
    (geometry : E1M1FiringGeometry.Inputs gun s actor thing angle ox oy)
    (line : Collision.Line) (p : Word)
    (back : load32 s.memory (p+50)=0 ↔ line.back.isNone=true)
    (safe : E1M1PathMapFiring.Safe gun s (p+50)) :
    load32 (firstScan gun s).core.memory (p+50)=0 ↔ line.back.isNone=true := by
  rw [E1M1ScanMemory.firing_frame gun s actor thing angle ox oy geometry _ safe]
  exact back

/-- Pure line data; the fraction still needs a successful production computation
on crossing lines. No value for an original reached register is supplied. -/
structure LineData where
  line : Collision.Line
  v : Word
  w : Word
  frac : Fixed

def candidate (trace : Collision.Divline) (lines : Word) (id : Nat) (d : LineData) : Candidate :=
  ⟨trace,d.line,linePointer lines id,d.v,d.w,d.frac,3,id,
    decide (OriginalLineSecondPoint.firstSide trace d.line≠OriginalLineSecondPoint.lastSide trace d.line)⟩

theorem candidate_continues (trace : Collision.Divline) (lines : Word) (id : Nat) (d : LineData) :
    (candidate trace lines id d).Continues := by
  right
  simp [Candidate.early,candidate]

/-- All immutable reads, including the four-byte window used to preserve each
16-bit list entry. Mutable visit stamps intentionally are not included. -/
def protectedWords (sp cursor : Word) (n : Nat) (cs : Nat → Candidate) : List Word :=
  [sp-(124#32),0x13580,0x2c120] ++
  (List.range (n+1)).map (fun i => cursor+BitVec.ofNat 32 (2*i)) ++
  (List.range n).flatMap (fun i => (cs i).reads)

theorem fixed_member (sp cursor : Word) (n : Nat) (cs : Nat → Candidate)
    (a : Word) (ha : a∈[sp-(124#32),(0x13580#32),0x2c120]) :
    a∈protectedWords sp cursor n cs := by
  exact List.mem_append_left _ (List.mem_append_left _ ha)

theorem list_member (sp cursor : Word) (n : Nat) (cs : Nat → Candidate) (i : Nat) (hi : i≤n) :
    cursor+BitVec.ofNat 32 (2*i)∈protectedWords sp cursor n cs := by
  apply List.mem_append_left
  apply List.mem_append_right
  exact List.mem_map.mpr ⟨i,List.mem_range.mpr (by omega),rfl⟩

theorem read_member (sp cursor : Word) (n : Nat) (cs : Nat → Candidate)
    (i : Nat) (hi : i<n) (a : Word) (ha : a∈(cs i).reads) :
    a∈protectedWords sp cursor n cs := by
  apply List.mem_append_right
  exact List.mem_flatMap.mpr ⟨i,List.mem_range.mpr hi,ha⟩

/-- One initial address contract protects a word from every possible line stamp
and callback stack write. Addresses use the original firing SP. -/
structure Protected (sp lines a : Word) : Prop where
  stamps : ∀ id<475, Apart a (OriginalLineVisits.stamp lines id)
  call : Apart a (sp-(128#32))
  side : SideSafe sp a
  scratch : ScratchSafe sp a

theorem protection (s : X86Memory.State) (sp lines : Word) (stack : s.regs 4=sp-(124#32))
    (i id : Nat) (bound : id<475)
    (pointer : OriginalLineDispatch.pointer (atIndex s i)=linePointer lines id)
    (a : Word) (safe : Protected sp lines a) :
    OriginalLineDispatch.Safe (atIndex s i) a ∧
    OriginalLineCrossing.SideSafe (OriginalLineDispatch.view (atIndex s i)) a ∧
    OriginalLineCrossing.ScratchSafe (OriginalLineDispatch.view (atIndex s i)) a := by
  refine ⟨⟨?_,?_⟩,E1M1ScanGeometry.side_safe s sp stack i a safe.side,
    E1M1ScanGeometry.scratch_safe s sp stack i a safe.scratch⟩
  · unfold OriginalLineDispatch.stamp
    rw [pointer]
    exact safe.stamps id bound
  · change Apart a (s.regs 4-(4#32))
    rw [stack]
    simpa [BitVec.sub_eq_add_neg,BitVec.add_assoc] using safe.call

structure Layout (sp cursor lines : Word) (n : Nat) (cs : Nat → Candidate) : Prop where
  words : ∀ a∈protectedWords sp cursor n cs, Protected sp lines a
  arrayWords : ∀ a∈protectedWords sp cursor n cs, ArraySafe 0x2ba20 a
  cursorSafe : Protected sp lines (0x2c028#32)
  stackArray : ∀ a∈[sp-(128#32),sp-(140#32)], ArraySafe 0x2ba20 a
  stampCall : ∀ id<475, Apart (OriginalLineVisits.stamp lines id) (sp-(128#32))
  storage : E1M1ScanGeometry.Storage sp lines

def candidates (trace : Collision.Divline) (lines : Word) (ids : List Nat) (data : Nat → LineData) (i : Nat) :=
  candidate trace lines ids[i]! (data i)

/-- Assemble the complete mixed-scan invariant. Geometry, back-sector encodings
and fractions are ordinary input data; list selection, side decisions, pointers,
protected-read membership and all reached-layout templates are derived. -/
def initial (s : X86Memory.State) (sp cursor lines : Word) (trace : Collision.Divline)
    (c : E1M1PathMap.Cell) (data : Nat → LineData)
    (stack : s.regs 4=sp-(124#32)) (list : s.regs 2=cursor)
    (items : E1M1PathMapLookup.ScanWords s lines c)
    (ids : ∀ i : Fin c.ids.length, c.ids[i.val]<475)
    (target : load32 s.memory (s.regs 4)=(0x2c5f0#32))
    (active : load32 s.memory 0x2c024=0)
    (geometry : ∀ i : Fin c.ids.length, Geometry (OriginalLineDispatch.view (atIndex s i.val))
      trace (data i.val).line (linePointer lines c.ids[i.val]) (data i.val).v (data i.val).w)
    (computed : ∀ i : Fin c.ids.length,
      OriginalLineSecondPoint.firstSide trace (data i.val).line≠OriginalLineSecondPoint.lastSide trace (data i.val).line →
      Collision.interceptVector trace ⟨(data i.val).line.x,(data i.val).line.y,(data i.val).line.dx,(data i.val).line.dy⟩=.ok (data i.val).frac)
    (back : ∀ i : Fin c.ids.length, load32 s.memory (linePointer lines c.ids[i.val]+50)=0 ↔ (data i.val).line.back.isNone=true)
    (layout : Layout sp cursor lines c.ids.length (candidates trace lines c.ids data)) :
    OriginalLineMixedInvariant.Initial s c.ids.length 0x2ba20 (E1M1PathMap.resolve lines) := by
  have idx (i : Fin c.ids.length) : c.ids[i.val]! = c.ids[i.val] := getElem!_pos c.ids i.val i.isLt
  have ptr (i : Fin c.ids.length) : OriginalLineDispatch.pointer (atIndex s i.val)=linePointer lines c.ids[i.val] :=
    items.pointers i (Fixed.ofInt 0)
  refine { candidates := candidates trace lines c.ids data
           words := protectedWords sp cursor c.ids.length (candidates trace lines c.ids data)
           listWords := ?_, fixedWords := ?_, target := target, nonlast := ?_
           reads := ?_, rejection := ?_, crossing := ?_, pointer := ?_
           separated := ?_, arrayWords := layout.arrayWords, cursorSafe := ?_
           stackArray := ?_, stampSafe := ?_, storage := ?_ }
  · intro i hi
    change s.regs 2+BitVec.ofNat 32 (2*i)∈_
    rw [list]; exact list_member _ _ _ _ i hi
  · intro a ha
    rw [stack] at ha
    exact fixed_member _ _ _ _ a ha
  · intro i hi; exact items.nonlast ⟨i,hi⟩
  · exact read_member _ _ _ _
  · intro i hi same
    have eq : OriginalLineSecondPoint.firstSide trace (data i).line=OriginalLineSecondPoint.lastSide trace (data i).line := by
      simpa [candidates,candidate] using same
    simpa only [candidates,candidate,idx ⟨i,hi⟩] using
      E1M1ScanGeometry.rejection_inputs _ _ _ _ _ _ (geometry ⟨i,hi⟩) eq
  · intro i hi crosses
    have ne : OriginalLineSecondPoint.firstSide trace (data i).line≠OriginalLineSecondPoint.lastSide trace (data i).line := by
      simpa [candidates,candidate] using crosses
    refine ⟨?_,computed ⟨i,hi⟩ ne,?_,?_⟩
    · simpa only [candidates,candidate,idx ⟨i,hi⟩] using
        E1M1ScanGeometry.crossing_inputs _ _ _ _ _ _ (geometry ⟨i,hi⟩) ne
    · change load32 s.memory 0x2c024≠0 ↔ (3:Nat) &&& 4≠0
      rw [active]; decide
    · change load32 s.memory (linePointer lines c.ids[i]!+50)=0 ↔ (data i).line.back.isNone=true
      rw [idx ⟨i,hi⟩]
      exact back ⟨i,hi⟩
  · intro i hi _; rfl
  · intro i hi a ha
    exact protection s sp lines stack i _ (ids ⟨i,hi⟩) (ptr ⟨i,hi⟩) a (layout.words a ha)
  · intro i hi
    exact protection s sp lines stack i _ (ids ⟨i,hi⟩) (ptr ⟨i,hi⟩) _ layout.cursorSafe
  · intro a ha
    change a∈[s.regs 4-(4#32),s.regs 4-(16#32)] at ha
    rw [stack] at ha
    apply layout.stackArray a
    simpa [BitVec.sub_eq_add_neg,BitVec.add_assoc] using ha
  · intro i hi
    unfold OriginalLineDispatch.stamp
    rw [ptr ⟨i,hi⟩,stack]
    simpa [OriginalLineVisits.stamp,linePointer,BitVec.sub_eq_add_neg,BitVec.add_assoc] using layout.stampCall _ (ids ⟨i,hi⟩)
  · intro i hi
    exact E1M1ScanGeometry.storage_layout s sp lines stack i _ (ids ⟨i,hi⟩) (ptr ⟨i,hi⟩) layout.storage

/-- Remaining mutable-stamp protection, distinct from immutable read words. -/
structure Stamps (sp lines : Word) : Prop where
  side : ∀ id<475, SideSafe sp (OriginalLineVisits.stamp lines id)
  scratch : ∀ id<475, ScratchSafe sp (OriginalLineVisits.stamp lines id)
  metadata : ∀ id<475, Apart (OriginalLineVisits.stamp lines id) (0x2c028#32)

section Joined
variable (s : X86Memory.State) (sp cursor lines : Word) (trace : Collision.Divline)
    (c : E1M1PathMap.Cell) (data : Nat → LineData)
    (stack : s.regs 4=sp-(124#32)) (list : s.regs 2=cursor)
    (items : E1M1PathMapLookup.ScanWords s lines c)
    (ids : ∀ i : Fin c.ids.length, c.ids[i.val]<475)
    (target : load32 s.memory (s.regs 4)=(0x2c5f0#32))
    (active : load32 s.memory 0x2c024=0)
    (geometry : ∀ i : Fin c.ids.length, Geometry (OriginalLineDispatch.view (atIndex s i.val))
      trace (data i.val).line (linePointer lines c.ids[i.val]) (data i.val).v (data i.val).w)
    (computed : ∀ i : Fin c.ids.length,
      OriginalLineSecondPoint.firstSide trace (data i.val).line≠OriginalLineSecondPoint.lastSide trace (data i.val).line →
      Collision.interceptVector trace ⟨(data i.val).line.x,(data i.val).line.y,(data i.val).line.dx,(data i.val).line.dy⟩=.ok (data i.val).frac)
    (back : ∀ i : Fin c.ids.length, load32 s.memory (linePointer lines c.ids[i.val]+50)=0 ↔ (data i.val).line.back.isNone=true)
    (layout : Layout sp cursor lines c.ids.length (candidates trace lines c.ids data))

include s sp cursor lines trace c data stack list items ids target active geometry computed back layout

local notation "assembled" => initial s sp cursor lines trace c data stack list items ids target active geometry computed back layout

/-- The same assembled scan contract now supplies the mutable visited-stamp
invariant. Record separation is reused symmetrically, not assumed again. -/
theorem visit_layout (stamps : Stamps sp lines) :
    OriginalLineVisits.Layout s assembled lines 475 := by
  refine ⟨by decide,?_,?_,?_,?_,?_,?_⟩
  · intro i hi
    change c.ids[i]!<475
    rw [getElem!_pos c.ids i hi]
    exact ids ⟨i,hi⟩
  · intro i hi
    change OriginalLineDispatch.pointer (atIndex s i)=linePointer lines c.ids[i]!
    rw [getElem!_pos c.ids i hi]
    exact items.pointers ⟨i,hi⟩ (Fixed.ofInt 0)
  · intro j hj
    rw [stack]
    simpa [BitVec.sub_eq_add_neg,BitVec.add_assoc] using layout.stampCall j hj
  · intro i _ j hj
    exact E1M1ScanGeometry.side_safe s sp stack i _ (stamps.side j hj)
  · intro i _ j hj
    exact E1M1ScanGeometry.scratch_safe s sp stack i _ (stamps.scratch j hj)
  · intro j hj
    exact ⟨fun k hk off ho => FloorCaller.apart_symm (layout.storage.stamps k hk off ho j hj),stamps.metadata j hj⟩

/-- Connect the assembled inputs to original execution and the Boolean visited
array, retaining the explicit initial representation and capacity premises. -/
theorem scan_execution (stamps : Stamps sp lines) (f : Option Flags) (r : Collision.PathResult)
    (collected : OriginalLineCollection.Tracks s 0x2ba20 (E1M1PathMap.resolve lines) r.collected c.ids.length)
    (epoch : Word) (seen : Array Bool) (size : seen.size=475)
    (represented : OriginalLineVisits.Represents s.memory lines epoch seen) :
    let out := OriginalLineScan.scan (candidates trace lines c.ids data) c.ids.length 0 ⟨s,f,0x2c57f⟩ r
    out.visits≤c.ids.length ∧
    (∃ steps≤281*out.visits, X86Routine.Prefix OriginalLineMixedInvariant.program [] steps
      ⟨s,f,0x2c57f⟩ out.machine) ∧
    OriginalLineVisits.Represents out.machine.core.memory lines epoch
      (OriginalLineVisits.markPrefix (candidates trace lines c.ids data) out.visits 0 seen) :=
  OriginalLineVisits.scan_execution s c.ids.length 0x2ba20 (E1M1PathMap.resolve lines) assembled lines 475
    (visit_layout s sp cursor lines trace c data stack list items ids target active geometry computed back layout stamps)
    f r collected epoch seen size represented

/-- Aiming's flag value proves continuation for every candidate. The sentinel
return and ordered collection follow without a per-line no-early-stop premise. -/
theorem through_sentinel (f : Option Flags) (r : Collision.PathResult)
    (collected : OriginalLineCollection.Tracks s 0x2ba20 (E1M1PathMap.resolve lines) r.collected c.ids.length) :
    let out := OriginalLineMixedInvariant.finished s c.ids.length 0x2ba20 (E1M1PathMap.resolve lines) assembled f r
    (∃ steps≤281*c.ids.length+7, X86Routine.Prefix OriginalLineMixedInvariant.program [] steps ⟨s,f,0x2c57f⟩ out.1) ∧
    OriginalLineTraversal.Runs ⟨s,f,0x2c57f⟩ out.1 c.ids.length ∧
    OriginalLineCollection.Tracks out.1.core 0x2ba20 (E1M1PathMap.resolve lines) out.2.collected 0 ∧
    (∀ a∈protectedWords sp cursor c.ids.length (candidates trace lines c.ids data),
      load32 out.1.core.memory a=load32 s.memory a) := by
  exact OriginalLineMixedInvariant.through_sentinel s c.ids.length 0x2ba20 (E1M1PathMap.resolve lines) assembled r
    f collected (fun i _ _ => candidate_continues trace lines c.ids[i]! (data i)) items.sentinel
end Joined
end Doom.Proofs.E1M1ScanContracts
